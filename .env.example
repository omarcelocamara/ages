# ─────────────────────────────────────────────────────────────
# Destino dos formulários de orçamento
# ─────────────────────────────────────────────────────────────
CONTACT_TO_EMAIL=adm.agesstudio@gmail.com

# ─────────────────────────────────────────────────────────────
# OPÇÃO A — Gmail SMTP (mais simples, não exige domínio próprio)
# 1. Ative a verificação em 2 etapas na conta Google
# 2. Gere uma "Senha de app" em https://myaccount.google.com/apppasswords
# 3. Preencha as duas variáveis abaixo
# ─────────────────────────────────────────────────────────────
GMAIL_USER=adm.agesstudio@gmail.com
GMAIL_APP_PASSWORD=

# ─────────────────────────────────────────────────────────────
# OPÇÃO B — Resend (recomendado se a AGES tiver domínio próprio)
# Crie a chave em https://resend.com/api-keys
# RESEND_FROM precisa ser de um domínio verificado no Resend.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM="AGES Creative Studio <site@seudominio.com.br>"
